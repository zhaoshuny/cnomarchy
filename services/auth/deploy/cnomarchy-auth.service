[Unit]
Description=CNomarchy Auth API Service
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/cnomarchy/auth
Environment="PATH=/opt/cnomarchy/auth/venv/bin"
EnvironmentFile=/opt/cnomarchy/auth/.env
ExecStart=/opt/cnomarchy/auth/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
