# CNomarchy 认证服务配置模板
# 复制为 .env 并填入实际值

# ============================================================
# 数据库
# ============================================================
# SQLite（开发/小规模）
DATABASE_URL=sqlite:///./cnomarchy_auth.db
# PostgreSQL（生产）
# DATABASE_URL=postgresql://user:password@localhost:5432/cnomarchy

# ============================================================
# JWT
# ============================================================
# ⚠️ 生产环境必须修改为随机长字符串
JWT_SECRET=change-me-to-a-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=90

# ============================================================
# 短信验证码
# ============================================================
# 服务商: aliyun (阿里云) / tencent (腾讯云) / mock (开发测试用)
SMS_PROVIDER=mock

# 验证码有效期（秒）
VERIFICATION_CODE_TTL=300
# 验证码长度
VERIFICATION_CODE_LENGTH=6
# 同一手机号发送间隔（秒）
SMS_SEND_INTERVAL=60
# 同一手机号每日最大发送次数
SMS_DAILY_LIMIT=10

# 阿里云短信配置
ALIYUN_ACCESS_KEY_ID=your_access_key_id
ALIYUN_ACCESS_KEY_SECRET=your_access_key_secret
ALIYUN_SIGN_NAME=CNomarchy
ALIYUN_TEMPLATE_CODE=SMS_XXXXXXXXXX
# 阿里云短信接入点（默认）
ALIYUN_ENDPOINT=dysmsapi.aliyuncs.com

# 腾讯云短信配置（备选）
TENCENT_SDK_APP_ID=your_sdk_app_id
TENCENT_SECRET_ID=your_secret_id
TENCENT_SECRET_KEY=your_secret_key
TENCENT_SIGN_NAME=CNomarchy
TENCENT_TEMPLATE_ID=your_template_id

# ============================================================
# 配置云同步（Git）
# ============================================================
# Git 仓库存储目录
GIT_SYNC_DIR=./git-repos
# Git 作者信息
GIT_AUTHOR_NAME=CNomarchy Bot
GIT_AUTHOR_EMAIL=bot@cnomarchy.local

# ============================================================
# 设备管理
# ============================================================
# 单用户最大设备数
MAX_DEVICES_PER_USER=10
# 新设备登录是否需要短信验证
REQUIRE_SMS_FOR_NEW_DEVICE=true

# ============================================================
# 服务
# ============================================================
HOST=0.0.0.0
PORT=8000
# 开发模式: true 显示详细错误
DEBUG=false
# 允许的 CORS 源（逗号分隔）
CORS_ORIGINS=*
