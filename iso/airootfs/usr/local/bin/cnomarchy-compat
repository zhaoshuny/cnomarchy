#!/usr/bin/env bash
# ============================================================
# CNomarchy 五层兼容层管理工具
# 用法:
#   cnomarchy-compat install [flatpak|waydroid|wine|pwa|all]
#   cnomarchy-compat remove  [flatpak|waydroid|wine|pwa|all]
#   cnomarchy-compat status
#   cnomarchy-compat help
# ============================================================

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

info()    { echo -e "${BLUE}[INFO]${NC} $1"; }
success() { echo -e "${GREEN}[OK]${NC} $1"; }
warn()    { echo -e "${YELLOW}[WARN]${NC} $1"; }
error()   { echo -e "${RED}[ERROR]${NC} $1"; }

# ============================================================
# 检查是否为 root
# ============================================================
check_root() {
    if [ "$EUID" -ne 0 ]; then
        error "请使用 sudo 运行此命令"
        exit 1
    fi
}

# ============================================================
# L1: Flatpak 兼容层
# ============================================================
install_flatpak() {
    info "安装 L1: Flatpak 兼容层..."

    if command -v flatpak &>/dev/null; then
        success "Flatpak 已安装"
    else
        pacman -S --noconfirm flatpak
        success "Flatpak 安装完成"
    fi

    # 添加 Flathub 国内镜像
    if ! flatpak remotes 2>/dev/null | grep -q flathub; then
        info "添加 Flathub 远程源（清华镜像）..."
        flatpak remote-add --if-not-exists flathub \
            https://mirror.tuna.tsinghua.edu.cn/flathub/flathub.flatpakrepo 2>/dev/null || \
        flatpak remote-add --if-not-exists flathub \
            https://dl.flathub.org/repo/flathub.flatpakrepo
        success "Flathub 源添加完成"
    else
        success "Flathub 源已存在"
    fi

    # 安装常用 Flatpak 应用
    info "安装常用 Flatpak 应用（可选）..."
    flatpak install -y flathub org.mozilla.firefox 2>/dev/null || true
    flatpak install -y flathub org.libreoffice.LibreOffice 2>/dev/null || true

    success "L1 Flatpak 兼容层安装完成"
    echo ""
    echo "📦 常用命令:"
    echo "  flatpak search <应用名>     搜索应用"
    echo "  flatpak install flathub <ID> 安装应用"
    echo "  flatpak list                 列出已安装应用"
    echo "  flatpak run <ID>             运行应用"
}

remove_flatpak() {
    info "移除 L1: Flatpak 兼容层..."
    pacman -Rns --noconfirm flatpak 2>/dev/null || true
    rm -rf /var/lib/flatpak 2>/dev/null || true
    rm -rf ~/.local/share/flatpak 2>/dev/null || true
    success "L1 Flatpak 兼容层已移除"
}

# ============================================================
# L2: Waydroid 安卓子系统
# ============================================================
install_waydroid() {
    info "安装 L2: Waydroid 安卓子系统..."

    # Waydroid 在 AUR 中，需要先安装 paru 或 yay
    if ! command -v paru &>/dev/null && ! command -v yay &>/dev/null; then
        info "安装 AUR 助手 paru..."
        pacman -S --noconfirm base-devel git
        cd /tmp
        git clone https://aur.archlinux.org/paru.git 2>/dev/null || true
        cd paru
        makepkg -si --noconfirm 2>/dev/null || warn "paru 安装失败，请手动安装"
        cd ..
        rm -rf paru
    fi

    # 安装 Waydroid
    if command -v paru &>/dev/null; then
        paru -S --noconfirm waydroid 2>/dev/null || warn "Waydroid 安装失败"
    elif command -v yay &>/dev/null; then
        yay -S --noconfirm waydroid 2>/dev/null || warn "Waydroid 安装失败"
    else
        error "未找到 AUR 助手，请先安装 paru 或 yay"
        return 1
    fi

    # 启用 Waydroid 服务
    systemctl enable --now waydroid-container 2>/dev/null || true

    # 初始化 Waydroid（需要用户交互）
    info "初始化 Waydroid..."
    waydroid init 2>/dev/null || warn "Waydroid 初始化需要手动运行: sudo waydroid init"

    success "L2 Waydroid 安卓子系统安装完成"
    echo ""
    echo "📱 常用命令:"
    echo "  waydroid session start    启动会话"
    echo "  waydroid app list         列出应用"
    echo "  waydroid app launch <包名> 启动应用"
    echo "  waydroid shell            进入 shell"
    echo "  waydroid show-full-ui     显示完整界面"
}

remove_waydroid() {
    info "移除 L2: Waydroid 安卓子系统..."
    systemctl stop waydroid-container 2>/dev/null || true
    systemctl disable waydroid-container 2>/dev/null || true
    pacman -Rns --noconfirm waydroid 2>/dev/null || true
    rm -rf /var/lib/waydroid 2>/dev/null || true
    rm -rf ~/.local/share/waydroid 2>/dev/null || true
    success "L2 Waydroid 安卓子系统已移除"
}

# ============================================================
# L3: Wine / Proton 兼容层
# ============================================================
install_wine() {
    info "安装 L3: Wine / Proton 兼容层..."

    # 启用 multilib 仓库
    if ! grep -q "^\[multilib\]" /etc/pacman.conf; then
        info "启用 multilib 仓库..."
        sed -i '/^#\[multilib\]/,/^#Include = \/etc\/pacman.d\/mirrorlist/ s/^#//' /etc/pacman.conf
        pacman -Syy
    fi

    # 安装 Wine 和相关工具
    pacman -S --noconfirm wine wine-mono wine-gecko winetricks
    pacman -S --noconfirm lutris 2>/dev/null || true
    pacman -S --noconfirm steam 2>/dev/null || true

    # 安装 Proton（通过 Steam）
    info "Proton 将通过 Steam 自动安装"

    success "L3 Wine / Proton 兼容层安装完成"
    echo ""
    echo "🍷 常用工具:"
    echo "  wine <程序.exe>         运行 Windows 程序"
    echo "  winetricks              安装依赖组件"
    echo "  lutris                  游戏管理平台"
    echo "  steam                   Steam 游戏平台（内置 Proton）"
}

remove_wine() {
    info "移除 L3: Wine / Proton 兼容层..."
    pacman -Rns --noconfirm wine wine-mono wine-gecko winetricks lutris steam 2>/dev/null || true
    rm -rf ~/.wine 2>/dev/null || true
    rm -rf ~/.local/share/lutris 2>/dev/null || true
    success "L3 Wine / Proton 兼容层已移除"
}

# ============================================================
# L4: PWA 渐进式网页应用
# ============================================================
install_pwa() {
    info "安装 L4: PWA 渐进式网页应用支持..."

    # 安装 Chromium（已预装）和 PWA 工具
    pacman -S --noconfirm chromium 2>/dev/null || true

    # 安装 Nativefier（将网页打包成桌面应用）
    if command -v npm &>/dev/null; then
        npm install -g nativefier 2>/dev/null || warn "nativefier 安装失败"
    else
        warn "未找到 npm，跳过 nativefier 安装"
    fi

    success "L4 PWA 支持安装完成"
    echo ""
    echo "🌐 使用方法:"
    echo "  1. 在 Chromium 中打开网站"
    echo "  2. 地址栏右侧点击安装图标"
    echo "  3. 网站将作为桌面应用安装"
    echo ""
    echo "📦 打包任意网站为桌面应用:"
    echo "  nativefier 'https://example.com' --name 'MyApp'"
}

remove_pwa() {
    info "移除 L4: PWA 支持..."
    npm uninstall -g nativefier 2>/dev/null || true
    rm -rf ~/.local/share/applications/*.desktop 2>/dev/null || true
    success "L4 PWA 支持已移除"
}

# ============================================================
# L5: 云桌面远程兜底
# ============================================================
install_cloud() {
    info "安装 L5: 云桌面远程兜底工具..."

    # 安装远程桌面工具
    pacman -S --noconfirm remmina 2>/dev/null || true
    pacman -S --noconfirm freerdp 2>/dev/null || true
    pacman -S --noconfirm tigervnc 2>/dev/null || true

    success "L5 云桌面远程工具安装完成"
    echo ""
    echo "☁️  常用工具:"
    echo "  remmina      远程桌面客户端（RDP/VNC/SSH）"
    echo "  xfreerdp      命令行 RDP 客户端"
    echo "  vncviewer     VNC 客户端"
}

remove_cloud() {
    info "移除 L5: 云桌面远程工具..."
    pacman -Rns --noconfirm remmina freerdp tigervnc 2>/dev/null || true
    success "L5 云桌面远程工具已移除"
}

# ============================================================
# 状态检查
# ============================================================
show_status() {
    echo "=========================================="
    echo "  CNomarchy 五层兼容层状态"
    echo "=========================================="
    echo ""

    # L1 Flatpak
    if command -v flatpak &>/dev/null; then
        echo -e "  ${GREEN}✅${NC} L1 Flatpak      已安装"
        flatpak list 2>/dev/null | wc -l | xargs echo "     已安装应用:"
    else
        echo -e "  ${RED}❌${NC} L1 Flatpak      未安装"
    fi

    # L2 Waydroid
    if command -v waydroid &>/dev/null; then
        echo -e "  ${GREEN}✅${NC} L2 Waydroid     已安装"
    else
        echo -e "  ${RED}❌${NC} L2 Waydroid     未安装"
    fi

    # L3 Wine
    if command -v wine &>/dev/null; then
        echo -e "  ${GREEN}✅${NC} L3 Wine/Proton  已安装"
    else
        echo -e "  ${RED}❌${NC} L3 Wine/Proton  未安装"
    fi

    # L4 PWA
    if command -v chromium &>/dev/null; then
        echo -e "  ${GREEN}✅${NC} L4 PWA          已安装 (Chromium)"
    else
        echo -e "  ${RED}❌${NC} L4 PWA          未安装"
    fi

    # L5 云桌面
    if command -v remmina &>/dev/null; then
        echo -e "  ${GREEN}✅${NC} L5 云桌面        已安装 (Remmina)"
    else
        echo -e "  ${RED}❌${NC} L5 云桌面        未安装"
    fi

    echo ""
    echo "=========================================="
}

# ============================================================
# 帮助
# ============================================================
show_help() {
    cat <<'EOF'
╔══════════════════════════════════════════════════╗
║        CNomarchy 五层兼容层管理工具               ║
╠══════════════════════════════════════════════════╣
║                                                    ║
║  用法: cnomarchy-compat <命令> [选项]             ║
║                                                    ║
║  命令:                                             ║
║    install [层]    安装指定兼容层                  ║
║    remove  [层]    移除指定兼容层                  ║
║    status          查看兼容层状态                  ║
║    help            显示此帮助                      ║
║                                                    ║
║  兼容层:                                           ║
║    flatpak   L1 - Flatpak 原生 Linux 应用         ║
║    waydroid  L2 - Waydroid 安卓子系统             ║
║    wine      L3 - Wine/Proton Windows 应用        ║
║    pwa       L4 - PWA 渐进式网页应用              ║
║    cloud     L5 - 云桌面远程兜底                   ║
║    all       安装/移除所有兼容层                   ║
║                                                    ║
║  示例:                                             ║
║    sudo cnomarchy-compat install flatpak           ║
║    sudo cnomarchy-compat install all               ║
║    cnomarchy-compat status                         ║
║                                                    ║
╚══════════════════════════════════════════════════╝
EOF
}

# ============================================================
# 主函数
# ============================================================
main() {
    local command=${1:-help}
    local layer=${2:-all}

    case $command in
        install)
            check_root
            case $layer in
                flatpak) install_flatpak ;;
                waydroid) install_waydroid ;;
                wine)    install_wine ;;
                pwa)     install_pwa ;;
                cloud)   install_cloud ;;
                all)
                    install_flatpak
                    install_waydroid
                    install_wine
                    install_pwa
                    install_cloud
                    ;;
                *)
                    error "未知兼容层: $layer"
                    show_help
                    exit 1
                    ;;
            esac
            ;;
        remove)
            check_root
            case $layer in
                flatpak) remove_flatpak ;;
                waydroid) remove_waydroid ;;
                wine)    remove_wine ;;
                pwa)     remove_pwa ;;
                cloud)   remove_cloud ;;
                all)
                    remove_flatpak
                    remove_waydroid
                    remove_wine
                    remove_pwa
                    remove_cloud
                    ;;
                *)
                    error "未知兼容层: $layer"
                    show_help
                    exit 1
                    ;;
            esac
            ;;
        status)
            show_status
            ;;
        help|--help|-h)
            show_help
            ;;
        *)
            error "未知命令: $command"
            show_help
            exit 1
            ;;
    esac
}

main "$@"
